{
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/sonia-narang-vsl-final.html"
    },
    {
      "src": "/terms-and-conditions",
      "dest": "/terms-and-conditions.html"
    },
    {
      "src": "/privacy-policy",
      "dest": "/privacy-policy.html"
    }
  ]
}